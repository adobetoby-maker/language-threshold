# Google Analytics 4 — Measurement ID
# Get from Google Analytics > Admin > Property Settings > Tracking ID
# Format: G-XXXXXXXXXX
VITE_GA_ID=

# Google Ads — Conversion ID
# Get from Google Ads > Goals > Conversions > Tag setup > Format: AW-XXXXXXXXX
VITE_GOOGLE_ADS_ID=

# Meta Pixel — Pixel ID
# Get from Meta Business Manager > Events Manager > Pixels > Format: 15-digit number
VITE_META_PIXEL_ID=

# Server-only API configuration. Never prefix these with VITE_ or expose them to the browser.
ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Speaking Engine provider spike. Preview/development only: the API refuses production even if these flags are set.
# All gates must be deliberately configured before the non-production connectivity scaffold can enable.
SPEAKING_SPIKE_ENABLED=false
SPEAKING_DATA_POLICY_APPROVED=false
SPEAKING_PRINCIPAL_SECRET=
DEEPGRAM_API_KEY=
SPEAKING_DIALOGUE_MODEL=claude-haiku-4-5
SPEAKING_TTS_MODEL=aura-2-celeste-es
