{
  "name": "language-threshold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:sanitizer && tsc -b && tsc -p tsconfig.blog.json && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "gen-cache": "node scripts/prebuild-word-cache.mjs",
    "build:sanitizer": "esbuild node_modules/sanitize-html/index.js --bundle --platform=node --format=cjs --outfile=server/sanitize.cjs",
    "pretest": "npm run build:sanitizer"
  },
  "dependencies": {
    "@heycatch/sdk": "^0.8.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "framer-motion": "^12.40.0",
    "node-html-parser": "^9.0.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-globe.gl": "^2.38.0",
    "react-router-dom": "^7.15.0",
    "sanitize-html": "^2.18.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@vercel/node": "^5.1.15",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "0.27.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
