{
  "redirects": [
    {
      "source": "/:l([a-z0-9])",
      "destination": "/?utm_source=heycatch&utm_campaign=:l",
      "statusCode": 302
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/blog?mode=sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/readers",
      "destination": "/readers/index.html"
    },
    {
      "source": "/readers/(.*)",
      "destination": "/readers/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/blog.ts": {
      "includeFiles": "server/{sitemap-base.xml,sanitize.cjs}",
      "maxDuration": 30
    }
  }
}
