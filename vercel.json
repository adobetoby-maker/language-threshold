{
  "redirects": [
    {
      "source": "/language-lens",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:l([a-z0-9])",
      "destination": "/?utm_source=heycatch&utm_campaign=:l",
      "statusCode": 302
    }
  ],
  "rewrites": [
    {
      "source": "/free-downloads",
      "destination": "/free-downloads/index.html"
    },
    {
      "source": "/free-downloads/",
      "destination": "/free-downloads/index.html"
    },
    {
      "source": "/free-downloads/(.*)",
      "destination": "/free-downloads/$1"
    },
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/readers",
      "destination": "/readers/index.html"
    },
    {
      "source": "/readers/(.*)",
      "destination": "/readers/$1"
    },
    {
      "source": "/app-walkthrough",
      "destination": "/app-walkthrough/index.html"
    },
    {
      "source": "/app-walkthrough/(.*)",
      "destination": "/app-walkthrough/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/blog.ts": {
      "includeFiles": "server/sanitize.cjs",
      "maxDuration": 30
    }
  }
}
